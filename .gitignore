# ============================================================
# 电商智能客服 - Git 忽略规则
# ============================================================

# ==================== Python ====================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# 虚拟环境（backend 下或根目录下）
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/

# ==================== Node / 前端 ====================
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# 前端构建产物
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
frontend/*.local

# ==================== 环境变量（含密钥）====================
# 后端
backend/.env
# 前端
frontend/.env
frontend/.env.local
frontend/.env.*.local
# Docker
docker/.env
# 根目录
.env
.env.local
.env.*.local

# 但所有 .env.example 要提交
!.env.example
!backend/.env.example
!frontend/.env.example
!docker/.env.example

# ==================== IDE ====================
.idea/
.vscode/
*.swp
*.swo
*.iml
*.iws
.project
.pydevproject
.settings/

# PyCharm
.idea/**/workspace.xml
.idea/**/tasks.xml
.idea/**/usage.statistics.xml
.idea/**/dictionaries
.idea/**/shelf/

# ==================== 数据库 ====================
*.sqlite3
*.db
*.sql.bak

# 但建表脚本要提交
!schema.sql

# ==================== 日志 ====================
logs/*
!logs/.gitkeep
*.log

